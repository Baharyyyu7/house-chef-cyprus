APP_NAME="House Chef Cyprus"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
TRUSTED_PROXIES=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=staging@example.com
MAIL_FROM_NAME="House Chef Cyprus Staging"

FILESYSTEM_DISK=public
PUBLIC_STORAGE_URL=
BACKUP_DISK=local
HEALTH_MONITORING_URL=

# Staging is deliberately non-indexable and must never auto-publish or bill.
SEO_INDEXING_ENABLED=false
SEO_CONTENT_AUTO_PUBLISH=false
GOOGLE_SEARCH_CONSOLE_ENABLED=false
INDEXNOW_ENABLED=false
X_API_ENABLED=false
X_AUTO_POST=false
RECIPE_IMAGE_GENERATION_ENABLED=false
RECIPE_IMAGE_AUTO_PUBLISH=false
CONTENT_AUTOMATION_ENABLED=true
CONTENT_AUTO_PUBLISH=false
CONTENT_REQUIRE_HUMAN_APPROVAL=true
CONTENT_MAX_RECIPE_DRAFTS_PER_DAY=25
CONTENT_MAX_BLOG_DRAFTS_PER_DAY=10
PEXELS_ENABLED=false
UNSPLASH_ENABLED=false
EDEN_AI_ENABLED=false

CORS_ALLOWED_ORIGINS=https://staging.example.com
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_IMAGE_PIXELS=24000000
