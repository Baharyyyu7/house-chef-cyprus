APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=
APP_COMMIT_SHA=
APP_TIMEZONE=Asia/Famagusta
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_RELEASE_STATE=production_ready
LOG_LEVEL=warning
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=
SESSION_DOMAIN=
SESSION_HTTP_ONLY=true
QUEUE_WORKER_MODE=cron_stop_when_empty
SCHEDULER_MAX_AGE_MINUTES=30

# Public API/browser policy: use a concrete comma-separated allowlist in production.
CORS_ALLOWED_ORIGINS=
CSP_REPORT_URI=
SENTRY_DSN=
ERROR_TRACKING_DSN=
CANONICAL_HOST=example.com
CANONICAL_SCHEME=https
WWW_REDIRECT_POLICY=to_apex
SEARCH_CONSOLE_VERIFICATION=
BING_VERIFICATION=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
GOOGLE_SEARCH_CONSOLE_ENABLED=false
GOOGLE_SEARCH_CONSOLE_PROPERTY=
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_DEBUG=false
GOOGLE_CONSENT_MODE_ENABLED=true
GOOGLE_TAG_MANAGER_ENABLED=false
GOOGLE_TAG_MANAGER_CONTAINER_ID=
# AdSense publisher ID is public. Keep delivery disabled until a
# Google-certified CMP handles advertising consent for EEA traffic.
GOOGLE_ADSENSE_ENABLED=false
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_VERIFICATION_META_ENABLED=false
GOOGLE_CERTIFIED_CMP_ENABLED=false
PAYMENTS_ENABLED=false
# Legacy fallback; PAYMENTS_ENABLED takes precedence.
MONETIZATION_PAYMENTS_ENABLED=false
MONETIZATION_TIP_MAX_AMOUNT=250
AFFILIATE_ALLOWED_HOSTS=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
STRIPE_REQUIRE_TERMS_CONSENT=true
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://housechefcyprus.com/auth/google/callback
CAPTCHA_PROVIDER=turnstile
GOOGLE_RECAPTCHA_ENABLED=false
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="House Chef Cyprus"
MAIL_SPF_VERIFIED=false
MAIL_DKIM_VERIFIED=false
MAIL_DMARC_VERIFIED=false
CONTACT_REQUEST_RECIPIENT=info@housechefcyprus.com
REGISTRATION_ADMIN_NOTIFICATION_TO=info@housechefcyprus.com
CONTACT_REQUEST_RETENTION_DAYS=730
CONTACT_CAPTCHA_ENABLED=false
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET=

FILESYSTEM_DISK=local
# Local disk remains private. Public media is served by the shell-managed
# public/storage -> shared/storage/app/public symlink.
PUBLIC_STORAGE_URL=https://housechefcyprus.com/storage
# A public recipe or blog image must pass the source, responsive-variant,
# uniqueness, fidelity and human-review gate. This value is not a credential.
MEDIA_PUBLIC_MINIMUM_FIDELITY_CONFIDENCE=90
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=

# Hostinger deployment contract. These names are non-secret; deployment inputs stay outside the repository.
DEPLOY_RELEASE_RETENTION=4
DEPLOY_ARTIFACT_REQUIRED=true

RECIPE_IMAGE_PRIMARY_PROVIDER=edenai
RECIPE_IMAGE_FALLBACK_PROVIDER=pexels
RECIPE_IMAGE_GENERATION_ENABLED=false
RECIPE_IMAGE_AUTO_PUBLISH=false
RECIPE_IMAGE_DAILY_BUDGET_USD=
RECIPE_IMAGE_MONTHLY_BUDGET_USD=
RECIPE_IMAGE_MAX_COST_PER_IMAGE_USD=
RECIPE_IMAGE_MAX_VARIATIONS=1
RECIPE_IMAGE_BATCH_SIZE=5
EDEN_AI_ENABLED=false
EDEN_AI_API_KEY=
EDEN_AI_BASE_URL=https://api.edenai.run/v3
EDEN_AI_IMAGE_MODEL=
PEXELS_ENABLED=false
PEXELS_API_KEY=
PEXELS_BASE_URL=https://api.pexels.com
UNSPLASH_ENABLED=false
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_BASE_URL=https://api.unsplash.com
UNSPLASH_APP_NAME=house-chef-cyprus
UNSPLASH_MAX_RESULTS_PER_RECIPE=5

BACKUP_DISK=local
BACKUP_PATH=backups
MYSQLDUMP_BINARY=
BACKUP_DUMP_TIMEOUT_SECONDS=900
BACKUP_MINIMUM_KEEP=2
BACKUP_SCHEDULED=true
HEALTH_MONITORING_URL=
UPTIME_HEALTH_TOKEN=
PRODUCTION_MAIL_REQUIRED=true
BACKUP_RETENTION_DAYS=30
MONITORING_ERROR_REPORTER=log

# Keep billable generation and automatic publication off until a human approves them.
RECIPE_IMAGE_GENERATION_ENABLED=false

# Privacy-aware activity and approximate geolocation. Keep raw IP out of UI/logs.
ACTIVITY_RETENTION_DAYS=90
LOGIN_METADATA_RETENTION_DAYS=30
IP_MASKING_ENABLED=true
GEOLOCATION_PROVIDER=null
GEOLOCATION_RETENTION_DAYS=30

# Search discovery
SITEMAP_CACHE_MINUTES=60

# SEO/content providers remain disabled until domain, consent, quotas and human review are approved.
SEO_LOCALE=tr
SEO_COUNTRY=CY
SEO_INDEXING_ENABLED=true
SEO_CONTENT_AUTO_PUBLISH=false
CONTENT_AUTOMATION_ENABLED=true
CONTENT_AUTO_PUBLISH=false
CONTENT_REQUIRE_HUMAN_APPROVAL=true
CONTENT_MAX_RECIPE_DRAFTS_PER_DAY=25
CONTENT_MAX_BLOG_DRAFTS_PER_DAY=10
CONTENT_MAX_REFRESH_DRAFTS_PER_DAY=5
SEO_MAX_DRAFTS_PER_DAY=5
SEO_MAX_REFRESH_DRAFTS_PER_DAY=5
SEO_MAX_SOCIAL_DRAFTS_PER_DAY=10
SEARCH_CONSOLE_ENABLED=false
SEARCH_CONSOLE_SITE_URL=
INDEXNOW_ENABLED=false
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
X_DISTRIBUTION_ENABLED=false
X_AUTO_POST=false

# Production security and proxy contract. Supply concrete values at deploy time.
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_IMAGE_PIXELS=24000000
CSP_REPORT_URI=
