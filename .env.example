APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=

# Comma-separated trusted browser origins. Never use * in production.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_IMAGE_PIXELS=24000000

# AI image pilot: defaults are deliberate hard stops until a cost approval is recorded.
GEMINI_API_KEY=
GEMINI_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
GEMINI_IMAGE_PILOT_STATUS=unavailable_for_pilot
BFL_IMAGE_ENABLED=false
BFL_API_KEY=
BFL_IMAGE_MODEL=flux-2-pro
BFL_IMAGE_BASE_URL=https://api.bfl.ai
BFL_IMAGE_POLL_LIMIT=10
BFL_IMAGE_POLL_INTERVAL_MS=500
BFL_IMAGE_ESTIMATE_CENTS=3
STABILITY_IMAGE_ENABLED=false
STABILITY_API_KEY=
STABILITY_IMAGE_MODEL=stable-image-core
STABILITY_IMAGE_BASE_URL=https://api.stability.ai
STABILITY_IMAGE_ESTIMATE_CENTS=10
RECIPE_IMAGE_PRIMARY_PROVIDER=bfl
RECIPE_IMAGE_FALLBACK_PROVIDER=stability
AI_IMAGE_FALLBACK_MAX_TOTAL_REQUESTS=2
AI_IMAGE_FALLBACK_MAX_REQUESTS_PER_PROVIDER=1
AI_IMAGE_FALLBACK_BUDGET_CENTS=20
AI_IMAGE_MAX_VARIATIONS_PER_RECIPE=2
AI_IMAGE_MAX_TOTAL_VARIATIONS=20
AI_IMAGE_DAILY_BUDGET_CENTS=0
AI_IMAGE_ESTIMATE_CENTS_PER_IMAGE=0
AI_IMAGE_MAX_RESPONSE_PAYLOAD_BYTES=12582912
AI_IMAGE_DIAGNOSTIC_MAX_CALLS=1
AI_IMAGE_DIAGNOSTIC_MAX_VARIATIONS=1
AI_IMAGE_DIAGNOSTIC_BUDGET_CENTS=10
OPENAI_IMAGE_ENABLED=false
OPENAI_API_KEY=
# Free local image generation. Keep disabled until a separately installed ComfyUI
# service has the Apache-2.0 FLUX.1 Schnell model and its required components.
RECIPE_IMAGE_PROVIDER=comfyui
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=
COMFYUI_MODEL=flux1-schnell
COMFYUI_TIMEOUT=900
COMFYUI_MAX_CONCURRENT_JOBS=1
COMFYUI_POLL_INTERVAL_MS=2000
COMFYUI_MAX_OUTPUT_BYTES=12582912
RECIPE_IMAGE_AUTO_PUBLISH=false
EDEN_AI_ENABLED=false
EDEN_AI_API_KEY=
EDEN_AI_BASE_URL=https://api.edenai.run/v3
EDEN_AI_IMAGE_MODEL=
PEXELS_ENABLED=false
PEXELS_API_KEY=
PEXELS_BASE_URL=https://api.pexels.com
UNSPLASH_ENABLED=false
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_BASE_URL=https://api.unsplash.com
UNSPLASH_APP_NAME=house-chef-cyprus
UNSPLASH_MAX_RESULTS_PER_RECIPE=5
RECIPE_IMAGE_DAILY_BUDGET_USD=
RECIPE_IMAGE_MONTHLY_BUDGET_USD=
RECIPE_IMAGE_MAX_COST_PER_IMAGE_USD=
RECIPE_IMAGE_BATCH_SIZE=5
DIFFUSERS_IMAGE_ENABLED=false
DIFFUSERS_IMAGE_ENDPOINT=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_STORAGE_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SEO & Content Automation: all external provider calls and public automation remain off by default.
SEO_LOCALE=tr
SEO_COUNTRY=CY
SEO_CONTENT_AUTO_PUBLISH=false
CONTENT_AUTOMATION_ENABLED=true
CONTENT_AUTO_PUBLISH=false
CONTENT_REQUIRE_HUMAN_APPROVAL=true
CONTENT_MAX_RECIPE_DRAFTS_PER_DAY=25
CONTENT_MAX_BLOG_DRAFTS_PER_DAY=10
CONTENT_MAX_REFRESH_DRAFTS_PER_DAY=5
SEO_MAX_DRAFTS_PER_DAY=5
SEO_MAX_REFRESH_DRAFTS_PER_DAY=5
SEO_MAX_SOCIAL_DRAFTS_PER_DAY=10
SEARCH_CONSOLE_ENABLED=false
SEARCH_CONSOLE_SITE_URL=
INDEXNOW_ENABLED=false
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
X_DISTRIBUTION_ENABLED=false
X_AUTO_POST=false
SEO_INDEXING_ENABLED=true
BACKUP_DISK=local
HEALTH_MONITORING_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
